# Copy to .env and fill in.

# "mock" (default) runs everything locally for free with fake images and a placeholder clip.
# "google" calls the real Gemini image API and Veo. Costs money.
PROVIDERS=mock

# Required when PROVIDERS=google. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hard cap on total paid spend recorded in the cost ledger (USD). Paid requests that would
# push past it are refused.
SPEND_CAP_USD=10

# Password login. Required whenever HOST is not localhost (e.g. on Render).
# APP_PASSWORD=at-least-12-characters
# SESSION_SECRET=at-least-32-random-characters
# TRUST_PROXY=1

# Optional overrides (defaults shown)
# PORT=4317
# HOST=127.0.0.1
# DATA_DIR=./data
# IMAGES_PER_BATCH=6
# IMAGE_MODEL=gemini-nano-banana-2.1
# IMAGE_SIZE=2K
# IMAGE_COST_USD=0.0504
# VIDEO_MODEL=veo-3.1-fast-generate-preview
# VIDEO_COST_PER_SECOND_USD=0.12
# VIDEO_POLL_INTERVAL_MS=10000
